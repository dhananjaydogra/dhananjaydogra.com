# Never apply line-ending conversion to binary assets.
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary

# Normalize text sources to LF in the repository.
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.md    text eol=lf
*.xml   text eol=lf
*.txt   text eol=lf
